# Public compile-only baseline; NOT the production generated configuration.
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_LIBC_NEWLIB=y
# CONFIG_LIBC_PICOLIBC is not set
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT is not set
# CONFIG_NVS_ENCRYPTION is not set

# Runtime owner has a 2 ms bounded scheduling period; 100 Hz quantizes it to 10 ms.
CONFIG_FREERTOS_HZ=1000
# Official NimBLE host PSRAM allocator; controller/DMA allocator remains internal.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# Protect internal/DMA requests from ordinary malloc pressure.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# Reduce persistent Wi-Fi RX allocation with matching BA window.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
