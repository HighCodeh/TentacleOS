# Flash — 8MB, 80MHz, DIO. NO_STUB required for C5 chip support in esptool.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_NO_STUB=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU 240MHz (C5 default is 160MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Single-core — C5 is unicore; without this FreeRTOS tries to start core 1
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP_SYSTEM_SINGLE_CORE_MODE=y

# No PSRAM on the HighBoy V2 PCB (matches InkTest).
# CONFIG_SPIRAM is not set

# Larger stack for kernel_init
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Console on USB-Serial-JTAG so UART0 is free for the C5 OTA receiver (see ota_service).
# C5 logs are also teed to the P4 over SPI, so no observability is lost.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Bluetooth NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Default log level INFO
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_VERSION_1=y

# Required for sys_monitor (uxTaskGetSystemState / vTaskList)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
