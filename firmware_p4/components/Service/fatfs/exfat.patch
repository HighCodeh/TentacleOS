+esp_err_t esp_vfs_fat_suspend(const char *base_path)
+{
+    size_t index = find_context_index_by_path(base_path);
+    if (index == FF_VOLUMES) return ESP_ERR_INVALID_STATE;
+    vfs_fat_ctx_t *ctx = s_fat_ctxs[index];
+    _lock_acquire(&ctx->lock);
+    esp_err_t result = ESP_ERR_INVALID_STATE;
+    for (size_t i = 0; i < ctx->max_files; ++i) {
+        if (ctx->files[i].obj.fs != NULL) goto done;
+    }
+#ifdef CONFIG_VFS_SUPPORT_DIR
+    if (!SLIST_EMPTY(&ctx->open_dirs)) goto done;
+#endif
+    result = f_mount(NULL, ctx->fat_drive, 0) == FR_OK ? ESP_OK : ESP_FAIL;
+done:
+    _lock_release(&ctx->lock);
+    return result;
+}
+
+esp_err_t esp_vfs_fat_resume(const char *base_path)
+{
+    size_t index = find_context_index_by_path(base_path);
+    if (index == FF_VOLUMES) return ESP_ERR_INVALID_STATE;
+    vfs_fat_ctx_t *ctx = s_fat_ctxs[index];
+    _lock_acquire(&ctx->lock);
+    FRESULT result = f_mount(&ctx->fs, ctx->fat_drive, 1);
+    if (result != FR_OK) f_mount(NULL, ctx->fat_drive, 0);
+    _lock_release(&ctx->lock);
+    return result == FR_OK ? ESP_OK : ESP_FAIL;
+}
+
+esp_err_t esp_vfs_fat_get_free_clusters(const char *base_path, FATFS **out_fs, DWORD *out_free)
+{
+    size_t index = find_context_index_by_path(base_path);
+    if (index == FF_VOLUMES) return ESP_ERR_INVALID_STATE;
+    vfs_fat_ctx_t *ctx = s_fat_ctxs[index];
+    _lock_acquire(&ctx->lock);
+    FRESULT result = f_getfree(ctx->fat_drive, out_free, out_fs);
+    _lock_release(&ctx->lock);
+    return result == FR_OK ? ESP_OK : ESP_FAIL;
+}
